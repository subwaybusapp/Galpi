{
  "expo": {
    "name": "transport-app",
    "slug": "transport-app",
    "scheme": "transport-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image-gen-1(3).png",
    "splash": {
      "image": "./assets/galpi-splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage":  "./assets/galpi-adaptive-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.galpi.transportapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons"
    ]
  }
}